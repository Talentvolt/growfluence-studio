# Copy this file to `server/.env` and fill in real values. Never commit `server/.env`.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Port the Express server listens on.
PORT=5000
# `development` or `production`.
NODE_ENV=development
# Comma-separated list of allowed frontend origins (no trailing slash).
# Example: http://localhost:5173,https://growfluencestudio.com
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# SMTP (outgoing email). Use an app password, never your account password.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-smtp-username@gmail.com
SMTP_PASS=your-app-password

# ---------------------------------------------------------------------------
# Mail routing
# ---------------------------------------------------------------------------
# Verified sender address (usually the same as SMTP_USER).
MAIL_FROM=Growfluencestudio@gmail.com
# Where enquiries are delivered.
MAIL_TO=Growfluencestudio@gmail.com
