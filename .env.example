# WhatsApp number in international format, digits only (no +, spaces or dashes).
# Used by the floating WhatsApp button in src/components/WhatsAppButton.jsx
VITE_WHATSAPP_NUMBER=919000000000

# Base URL of the Express backend that handles the contact form.
# Local dev: http://localhost:5000  |  Production: https://api.yourdomain.com
VITE_API_URL=http://localhost:5000
